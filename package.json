{
  "name": "graph-project-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable graph-centric project development framework",
  "bin": {
    "framework": "src/cli.ts"
  },
  "scripts": {
    "framework": "node --experimental-strip-types src/cli.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:studio": "node --test tests/studio.test.mjs",
    "check": "node --experimental-strip-types src/cli.ts check .",
    "test:studio:browser": "node --test tests/studio-browser.test.mjs tests/paper-studio-browser.test.mjs",
    "test:studio:layout": "node --test tests/canvas-layout.test.mjs",
    "workspace": "node --experimental-strip-types src/workspace-cli.ts",
    "test:workspace": "node --experimental-strip-types --test tests/projects.test.ts tests/documents.test.ts tests/project-client.test.mjs",
    "test:workspace:browser": "node --experimental-strip-types --test tests/projects-browser.test.mjs",
    "test:workspace:live": "node --experimental-strip-types --test tests/projects-live-browser.test.mjs",
    "context:task": "node --experimental-strip-types src/task-context-cli.ts",
    "test:authoring": "node --experimental-strip-types --test tests/visual-authoring.test.ts tests/task-context.test.ts tests/authoring-http.test.ts",
    "test:authoring:browser": "node --experimental-strip-types --test tests/authoring-browser.test.mjs",
    "context:target": "node --experimental-strip-types src/implementation-context-cli.ts",
    "test:targets": "node --experimental-strip-types --test tests/implementation-targets.test.ts tests/implementation-context.test.ts",
    "test:targets:browser": "node --experimental-strip-types --test tests/implementation-targets-browser.test.mjs",
    "test:canvas:edit": "node --test tests/canvas-edit.test.mjs",
    "test:canvas:browser": "node --test tests/direct-canvas-browser.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  }
}
